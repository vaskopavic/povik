{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["POVIK_*", "VITE_*"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["transit"],
      "env": ["POVIK_TEST_DATABASE_URL"],
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["@povik/web#build", "@povik/server#build"],
      "cache": false,
      "passThroughEnv": ["POVIK_*", "CI"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["POVIK_*"]
    }
  }
}
